{
  "name": "nabu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trener języków obcych dla Polaków — zdania z korpusu, quiz, offline",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build:data": "node --max-old-space-size=4096 build/05-assemble.ts",
    "build:fonts": "node build/07-fonts.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "kuromoji": "^0.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
